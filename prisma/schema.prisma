// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String
  role            String    @default("learner") // "learner" | "senior" | "student" | "admin"

  // プロフィール（共通）
  avatar          String?
  bio             String?   @db.Text  // 自己紹介
  interests       String[]  // 興味タグ ["料理", "歴史", "ビジネス", "アニメ"]
  languages       String[]  // 話せる言語 ["日本語", "英語"]

  // 外国人学習者用フィールド
  jlptLevel       String?   // "N1" | "N2" | "N3" | "N4" | "N5"
  nativeLanguage  String?   // 母国語
  learningGoal    String?   // "business" | "casual" | "both"
  country         String?   // 出身国
  wantsToWorkInJapan Boolean @default(false)
  textbook        String?   // 使用教科書 "minna_no_nihongo" | "genki" | etc.
  currentLesson   Int?      // 現在の課

  // 日本人シニア用フィールド
  careerHistory   String?   @db.Text  // これまでの経歴
  expertise       String[]  // 得意分野 ["営業", "人事", "製造"]
  birthDate       DateTime? // 生年月日
  emergencyContactEmail String? // 緊急連絡先メールアドレス
  emergencyContactName  String? // 緊急連絡先名前
  prefecture      String?   // 都道府県
  hobbies         String[]  // 趣味
  expertiseTopics String[]  // 得意な話題
  speakingStyle   String?   // 話し方の特徴
  isDummy         Boolean   @default(false) // ダミーフラグ

  // 日本人大学生用フィールド
  university      String?   // 大学名
  major           String?   // 専攻
  graduationYear  Int?      // 卒業予定年

  // 統計
  totalTalkTime   Int       @default(0) // 総会話時間（分）
  averageRating   Float     @default(0) // 平均評価
  totalSessions   Int       @default(0) // 総セッション数
  totalEarnings   Int       @default(0) // 総収益（円） ← 大学生向け

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // 利用規約
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  // SNS投稿関連
  totalPosts       Int      @default(0)     // 総投稿数
  canBookSession   Boolean  @default(false) // 面談予約可能か
  minPostsRequired Int      @default(4)     // 必要な投稿数（デフォルト4日分）

  // リレーション
  slots                   Slot[]
  reservationsAsLearner   Reservation[] @relation("LearnerReservations")
  reservationsAsHost      Reservation[] @relation("HostReservations")
  feedbackGiven           Feedback[]    @relation("FeedbackGiver")
  feedbackReceived        Feedback[]    @relation("FeedbackReceiver")
  reports                 Report[]      @relation("Reporter")
  payouts                 Payout[]
  studyLogs               StudyLog[]
  studyPosts              StudyPost[]
  likes                   Like[]
  conversationHistories   ConversationHistory[]

  @@index([email])
  @@index([role])
  @@index([lastLoginAt])
  @@map("users")
}

// 予約枠（日本人が作成）
model Slot {
  id          String   @id @default(cuid())
  hostId      String
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // セッションタイプ
  sessionType String   // "business" | "casual" | "both"

  // 日時（UTC）
  startTime   DateTime
  endTime     DateTime // startTime + 25分

  // ステータス
  status      String   @default("available") // "available" | "reserved" | "completed" | "cancelled"

  // 予約情報
  reservation Reservation?

  createdAt   DateTime @default(now())

  @@index([hostId, startTime])
  @@index([status, startTime])
  @@index([sessionType])
  @@map("slots")
}

// 予約
model Reservation {
  id          String   @id @default(cuid())

  // スロット
  slotId      String   @unique
  slot        Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // 参加者
  learnerId   String
  learner     User     @relation("LearnerReservations", fields: [learnerId], references: [id], onDelete: Cascade)

  hostId      String
  host        User     @relation("HostReservations", fields: [hostId], references: [id], onDelete: Cascade)

  // セッション情報
  status      String   @default("pending") // "pending" | "active" | "completed" | "cancelled" | "noshow"
  sessionType String   // "business" | "casual"

  // Agora/ビデオ通話情報
  channelName String?
  token       String?

  // 学習準備状態
  readyToTalk   Boolean  @default(false) // 4枚提出完了
  studyLogCount Int      @default(0)     // 提出済み枚数

  // 会話準備（学習者が入力）
  selectedTopic           String?    // 選択したトピック
  grammarToStudy          String[]   // 練習したい文法
  conversationGoal        String?    // 会話の目標
  additionalNotes         String?    @db.Text // 補足メモ
  sharedMaterial          String?    // 共有資料（PDF URL等）
  generatedAgenda         Json?      // 生成されたアジェンダ
  progressSinceLastSession String?   // "new_lesson" | "same_lesson_new_grammar" | "same" | "review"

  // タイムスタンプ
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt   DateTime @default(now())

  // リレーション
  feedback    Feedback[]
  studyLogs   StudyLog[]

  @@index([learnerId])
  @@index([hostId])
  @@index([status])
  @@map("reservations")
}

// 学習記録（写真提出）
model StudyLog {
  id              String   @id @default(cuid())

  // 関連
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  learnerId       String
  learner         User     @relation(fields: [learnerId], references: [id])

  // 写真情報
  imageUrl        String   // 画像URL
  imageOrder      Int      // 1〜4の順番

  // AI分析結果（JSON）
  analysisResult  Json?    // 構造化データ

  // ホストからのリアクション
  hostLiked       Boolean  @default(false)
  hostComment     String?
  hostReactions   Json?    // { liked: boolean, likeCount: number, stamps: string[], hostComment?: string }

  // タイムスタンプ
  uploadedAt      DateTime @default(now())

  @@unique([reservationId, imageOrder])
  @@index([learnerId])
  @@index([reservationId])
  @@map("study_logs")
}

// 評価
model Feedback {
  id            String   @id @default(cuid())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  giverId       String
  giver         User     @relation("FeedbackGiver", fields: [giverId], references: [id])

  receiverId    String
  receiver      User     @relation("FeedbackReceiver", fields: [receiverId], references: [id])

  // 評価内容
  rating        Int      // 1-5
  enjoyment     Int?     // 楽しさ（1-5）
  wantAgain     Boolean? // また話したいか

  // 日本語評価（日本人→学習者のみ）
  vocabularyLevel    Int? // 語彙力（1-5）
  pronunciationLevel Int? // 発音（1-5）
  communicationLevel Int? // コミュニケーション（1-5）

  // 会話評価（学習者→日本人）
  teachingQuality    Int? // 教え方（1-5）
  friendliness       Int? // 親しみやすさ（1-5）
  patience           Int? // 忍耐力（1-5）

  comment       String?  @db.Text

  createdAt     DateTime @default(now())

  @@unique([reservationId, giverId])
  @@index([receiverId])
  @@map("feedback")
}

// 支払い（大学生・シニア向け）
model Payout {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  amount      Int      // 支払い額（円）
  sessions    Int      // セッション数
  status      String   @default("pending") // "pending" | "paid" | "cancelled"

  // 振込情報
  bankName      String?
  branchName    String?
  accountType   String?  // "普通" | "当座"
  accountNumber String?
  accountHolder String?

  requestedAt DateTime @default(now())
  paidAt      DateTime?

  @@index([userId, status])
  @@map("payouts")
}

// 通報
model Report {
  id             String   @id @default(cuid())

  reporterId     String
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id])

  reportedUserId String
  reason         String   // "inappropriate" | "noshow" | "spam" | "other"
  description    String?  @db.Text

  status         String   @default("pending") // "pending" | "resolved" | "dismissed"

  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@map("reports")
}

// 運営からのメッセージ
model AdminMessage {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  messageType String    // "info" | "warning" | "success" | "announcement"
  targetRole  String?   // "all" | "learner" | "senior" | "student" | null(=all)
  isActive    Boolean   @default(true)
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@index([targetRole])
  @@map("admin_messages")
}

// SNS風学習記録投稿
model StudyPost {
  id          String   @id @default(cuid())

  // 投稿者
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 投稿内容
  imageUrl    String   // 写真URL
  caption     String?  @db.Text // キャプション（コメント）

  // AI分析（オプション）
  analysisResult Json?

  // いいねカウント（非正規化）
  likeCount   Int      @default(0)

  // タイムスタンプ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // リレーション
  likes       Like[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("study_posts")
}

// いいね
model Like {
  id          String   @id @default(cuid())

  postId      String
  post        StudyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String   // いいねしたユーザー
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([postId, userId]) // 1人1回まで
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

// 会話履歴（重複防止用）
model ConversationHistory {
  id            String   @id @default(cuid())

  learnerId     String
  learner       User     @relation(fields: [learnerId], references: [id])

  seniorId      String
  reservationId String

  date          DateTime
  topic         String   // 話したトピック
  grammarPoints String[] // 使った文法
  vocabulary    String[] // 使った語彙

  // アジェンダ（JSON）
  agenda        Json?

  // フィードバック
  seniorComment String?
  learnerRating Int?

  createdAt     DateTime @default(now())

  @@index([learnerId])
  @@index([seniorId])
  @@map("conversation_histories")
}

// トピックマスター
model Topic {
  id          String   @id @default(cuid())
  name        String   // 表示名（英語）
  nameJa      String   // 表示名（日本語）
  category    String   // カテゴリ
  level       String   // 推奨レベル（N5, N4, N3...）
  keywords    String[] // 関連キーワード
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@map("topics")
}

// 文法マスター
model GrammarPoint {
  id            String   @id @default(cuid())
  pattern       String   // 〜てもいいですか
  meaning       String   // May I...?
  level         String   // N5, N4, N3...
  textbookRefs  String[] // ["minna_12", "genki_8"]
  exampleSentences Json  // 例文
  relatedTopics String[] // 関連トピック

  createdAt     DateTime @default(now())

  @@map("grammar_points")
}
