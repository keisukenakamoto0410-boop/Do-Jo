// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String
  role            String    @default("learner") // "learner" | "senior" | "student" | "admin"

  // OAuth Provider IDs
  lineId          String?   @unique  // LINE user ID for LINE notifications

  // LINE登録フロー用
  registrationStep String?   // "AWAITING_NAME" | "AWAITING_GENDER" | "AWAITING_AGE" | "AWAITING_AREA" | "AWAITING_INTERESTS" | "AWAITING_BIO" | "COMPLETED"
  selectedDays    String?   // JSON配列: 選択中の曜日
  scheduleStep    String?   // JSON: スケジュール登録の進捗状態
  gender          String?   // "male" | "female" | "other"

  // プロフィール（共通）
  avatar          String?
  bio             String?   @db.Text  // 自己紹介
  interests       String[]  // 興味タグ ["料理", "歴史", "ビジネス", "アニメ"]
  languages       String[]  // 話せる言語 ["日本語", "英語"]

  // 外国人学習者用フィールド
  jlptLevel       String?   // "N1" | "N2" | "N3" | "N4" | "N5"
  nativeLanguage  String?   // 母国語
  learningGoal    String?   // "business" | "casual" | "both"
  country         String?   // 出身国
  wantsToWorkInJapan Boolean @default(false)
  textbook        String?   // 使用教科書 "minna_no_nihongo" | "genki" | etc.
  currentLesson   Int?      // 現在の課

  // 地元自慢（Learner用）
  hometownFood      String?   // 地元の自慢料理名
  hometownFoodDesc  String?   // 料理の説明（日本語）
  hometownPlace     String?   // おすすめ観光地名
  hometownPlaceDesc String?   // 観光地の説明（日本語）

  // 日本人シニア用フィールド
  careerHistory   String?   @db.Text  // これまでの経歴
  expertise       String[]  // 得意分野 ["営業", "人事", "製造"]
  ageRange        String?   // 年代 "50s" | "60s" | "70s" | "80s"
  prefecture      String?   // 都道府県
  hobbies         String[]  // 趣味
  expertiseTopics String[]  // 得意な話題
  speakingStyle   String?   // 話し方の特徴

  // 日本人大学生用フィールド
  university      String?   // 大学名
  major           String?   // 専攻
  graduationYear  Int?      // 卒業予定年

  // 統計
  totalTalkTime   Int       @default(0) // 総会話時間（分）
  averageRating   Float     @default(0) // 平均評価
  totalSessions   Int       @default(0) // 総セッション数
  // totalEarnings removed - use external payment service
  consecutiveDays Int       @default(0) // 連続会話日数
  lastConversationDate DateTime? // 最後の会話日
  uniquePartners  Int       @default(0) // 会話した人数

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // 利用規約
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  // パスワードリセット
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // SNS投稿関連
  totalPosts       Int      @default(0)     // 総投稿数

  // LINE Bot連打対策
  isProcessing     Boolean  @default(false) // 処理中フラグ

  // リレーション
  slots                   Slot[]
  reservationsAsLearner   Reservation[] @relation("LearnerReservations")
  reservationsAsHost      Reservation[] @relation("HostReservations")
  feedbackGiven           Feedback[]    @relation("FeedbackGiver")
  feedbackReceived        Feedback[]    @relation("FeedbackReceiver")
  reports                 Report[]      @relation("Reporter")
  // payouts removed - use external payment service
  studyLogs               StudyLog[]
  studyPosts              StudyPost[]
  likes                   Like[]
  comments                Comment[]
  conversationHistories   ConversationHistory[]
  medals                  UserMedal[]
  sessionMessages         SessionMessage[]

  @@index([email])
  @@index([role])
  @@index([lastLoginAt])
  @@map("users")
}

// 予約枠（日本人が作成）
model Slot {
  id          String   @id @default(cuid())
  hostId      String
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // セッションタイプ
  sessionType String   // "business" | "casual" | "both"

  // 日時（UTC）
  startTime   DateTime
  endTime     DateTime // startTime + 25分

  // ステータス
  status      String   @default("available") // "available" | "reserved" | "completed" | "cancelled"

  // 予約情報
  reservation Reservation?

  createdAt   DateTime @default(now())

  @@index([hostId, startTime])
  @@index([status, startTime])
  @@index([sessionType])
  @@map("slots")
}

// 予約
model Reservation {
  id          String   @id @default(cuid())

  // スロット
  slotId      String   @unique
  slot        Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // 参加者
  learnerId   String
  learner     User     @relation("LearnerReservations", fields: [learnerId], references: [id], onDelete: Cascade)

  hostId      String
  host        User     @relation("HostReservations", fields: [hostId], references: [id], onDelete: Cascade)

  // セッション情報
  status      String   @default("pending") // "pending" | "active" | "completed" | "cancelled" | "noshow"
  sessionType String   // "business" | "casual"

  // Agora/ビデオ通話情報
  channelName String?
  token       String?

  // 学習準備状態
  readyToTalk   Boolean  @default(false) // 4枚提出完了
  studyLogCount Int      @default(0)     // 提出済み枚数

  // 会話準備（学習者が入力）
  selectedTopic           String?    // 選択したトピック
  slideTopic              String?    // スライド用トピック (food, travel, etc.)
  grammarToStudy          String[]   // 練習したい文法
  targetWords             String[]   // ターゲット単語（最大5個）
  conversationGoal        String?    // 会話の目標
  additionalNotes         String?    @db.Text // 補足メモ
  sharedMaterial          String?    // 共有資料（PDF URL等）
  generatedAgenda         Json?      // 生成されたアジェンダ
  progressSinceLastSession String?   // "new_lesson" | "same_lesson_new_grammar" | "same" | "review"

  // セッション入室管理
  learnerJoinedAt   DateTime?  // 学習者入室時刻
  hostJoinedAt      DateTime?  // シニア入室時刻
  sessionStartedAt  DateTime?  // 両者揃った時刻（タイマー開始）

  // タイムスタンプ
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt   DateTime @default(now())

  // リマインダーメール送信済みフラグ
  reminderSent Boolean @default(false)

  // リレーション
  feedback    Feedback[]
  studyLogs   StudyLog[]
  sessionFeedback SessionFeedback?
  detailedFeedback DetailedFeedback?
  messages    SessionMessage[]

  @@index([learnerId])
  @@index([hostId])
  @@index([status])
  @@map("reservations")
}

// 学習記録（写真提出）
model StudyLog {
  id              String   @id @default(cuid())

  // 関連
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  learnerId       String
  learner         User     @relation(fields: [learnerId], references: [id])

  // 写真情報
  imageUrl        String   // 画像URL
  imageOrder      Int      // 1〜4の順番

  // AI分析結果（JSON）
  analysisResult  Json?    // 構造化データ

  // ホストからのリアクション
  hostLiked       Boolean  @default(false)
  hostComment     String?
  hostReactions   Json?    // { liked: boolean, likeCount: number, stamps: string[], hostComment?: string }

  // タイムスタンプ
  uploadedAt      DateTime @default(now())

  @@unique([reservationId, imageOrder])
  @@index([learnerId])
  @@index([reservationId])
  @@map("study_logs")
}

// 評価
model Feedback {
  id            String   @id @default(cuid())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  giverId       String
  giver         User     @relation("FeedbackGiver", fields: [giverId], references: [id])

  receiverId    String
  receiver      User     @relation("FeedbackReceiver", fields: [receiverId], references: [id])

  // 評価内容
  rating        Int      // 1-5
  enjoyment     Int?     // 楽しさ（1-5）
  wantAgain     Boolean? // また話したいか

  // 日本語評価（日本人→学習者のみ）
  vocabularyLevel    Int? // 語彙力（1-5）
  pronunciationLevel Int? // 発音（1-5）
  communicationLevel Int? // コミュニケーション（1-5）

  // 会話評価（学習者→日本人）
  teachingQuality    Int? // 教え方（1-5）
  friendliness       Int? // 親しみやすさ（1-5）
  patience           Int? // 忍耐力（1-5）

  comment       String?  @db.Text

  createdAt     DateTime @default(now())

  @@unique([reservationId, giverId])
  @@index([receiverId])
  @@map("feedback")
}

// 詳細フィードバック（シニア→学習者、就職支援向け）
model DetailedFeedback {
  id                  String   @id @default(cuid())

  reservationId       String   @unique
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // 話したトピック
  topics              String[]

  // 評価スコア（1-5）
  pronunciationScore  Int      // 発音
  grammarScore        Int      // 文法・言葉の使い方
  enthusiasmScore     Int      // 会話への積極性
  comprehensionScore  Int      // 聞き取り・理解力

  // コメント
  goodExpression      String?  @db.Text  // 良かった表現
  improvementFrom     String?  // 改善前
  improvementTo       String?  // 改善後
  encouragementMessage String  @db.Text  // 応援メッセージ（必須）

  createdAt           DateTime @default(now())

  @@index([reservationId])
  @@map("detailed_feedback")
}

// 通報
model Report {
  id             String   @id @default(cuid())

  reporterId     String
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id])

  reportedUserId String
  reason         String   // "inappropriate" | "noshow" | "spam" | "other"
  description    String?  @db.Text

  status         String   @default("pending") // "pending" | "resolved" | "dismissed"

  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@map("reports")
}

// 運営からのメッセージ
model AdminMessage {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  messageType String    // "info" | "warning" | "success" | "announcement"
  targetRole  String?   // "all" | "learner" | "senior" | "student" | null(=all)
  isActive    Boolean   @default(true)
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@index([targetRole])
  @@map("admin_messages")
}

// SNS風学習記録投稿
model StudyPost {
  id          String   @id @default(cuid())

  // 投稿者
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 投稿内容
  imageUrl    String   // 写真URL
  caption     String?  @db.Text // キャプション（コメント）

  // AI分析（オプション）
  analysisResult Json?

  // いいねカウント（非正規化）
  likeCount   Int      @default(0)

  // タイムスタンプ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // コメント数（非正規化）
  commentCount Int @default(0)

  // リレーション
  likes       Like[]
  comments    Comment[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("study_posts")
}

// いいね
model Like {
  id          String   @id @default(cuid())

  postId      String
  post        StudyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String   // いいねしたユーザー
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([postId, userId]) // 1人1回まで
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

// コメント
model Comment {
  id          String   @id @default(cuid())

  postId      String
  post        StudyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  content     String   @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

// 会話履歴（重複防止用）
model ConversationHistory {
  id            String   @id @default(cuid())

  learnerId     String
  learner       User     @relation(fields: [learnerId], references: [id])

  seniorId      String
  reservationId String

  date          DateTime
  topic         String   // 話したトピック
  grammarPoints String[] // 使った文法
  vocabulary    String[] // 使った語彙

  // アジェンダ（JSON）
  agenda        Json?

  // フィードバック
  seniorComment String?
  learnerRating Int?

  createdAt     DateTime @default(now())

  @@index([learnerId])
  @@index([seniorId])
  @@map("conversation_histories")
}

// トピックマスター
model Topic {
  id          String   @id @default(cuid())
  name        String   // 表示名（英語）
  nameJa      String   // 表示名（日本語）
  category    String   // カテゴリ
  level       String   // 推奨レベル（N5, N4, N3...）
  keywords    String[] // 関連キーワード
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@map("topics")
}

// 文法マスター
model GrammarPoint {
  id            String   @id @default(cuid())
  pattern       String   // 〜てもいいですか
  meaning       String   // May I...?
  level         String   // N5, N4, N3...
  textbookRefs  String[] // ["minna_12", "genki_8"]
  exampleSentences Json  // 例文
  relatedTopics String[] // 関連トピック

  createdAt     DateTime @default(now())

  @@map("grammar_points")
}

// セッション後フィードバック（シニア→学習者への評価）
model SessionFeedback {
  id              String   @id @default(cuid())
  reservationId   String   @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // Q1-Q4の回答 (0=いいえ/よくあった, 1=ときどき, 2=はい/なかった)
  q1Accurate     Int      // 的確な応答
  q2Keigo        Int      // 敬語使用
  q3Naturalness  Int      // 自然さ (逆転: 0=よくあった, 1=ときどき, 2=なかった)
  q4NativeFeel   Int      // ネイティブ感覚

  totalScore      Int      // 合計スコア (0-8)
  level           String   // N/F/B/L
  message         String?  @db.Text // シニアからのメッセージ

  createdAt       DateTime @default(now())

  @@index([reservationId])
  @@map("session_feedback")
}

// スライド同期用セッション
model SlideSession {
  id            String   @id @default(cuid())
  reservationId String   @unique
  currentSlide  Int      @default(1)
  slideTopic    String?  // トピックID (food, travel, etc.)
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([reservationId])
  @@map("slide_sessions")
}

// ユーザーが獲得したメダル
model UserMedal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  medalType   String   // メダルタイプ: "first_session", "topic_food", "topic_travel", etc.
  earnedAt    DateTime @default(now())

  // 関連する予約（オプション）
  reservationId String?

  @@unique([userId, medalType]) // 同じメダルは1回のみ
  @@index([userId])
  @@map("user_medals")
}

// 学習者からホストへのお礼メッセージ
model ThankYouMessage {
  id            String   @id @default(cuid())
  reservationId String   @unique

  // 送信者（学習者）
  learnerId     String
  learnerName   String   // 送信時の名前を保存

  // 受信者（ホスト）
  hostId        String

  // メッセージ内容
  message       String   @db.Text  // お礼メッセージ
  rating        Int?     // 評価（1-5、オプション）
  emoji         String?  // 選択した絵文字

  // 既読フラグ
  isRead        Boolean  @default(false)
  readAt        DateTime?

  createdAt     DateTime @default(now())

  @@index([hostId, isRead])
  @@index([learnerId])
  @@map("thank_you_messages")
}

// セッション中のチャットメッセージ
model SessionMessage {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@index([senderId])
  @@map("session_messages")
}

// 商品マッピング（地元料理→Amazon商品）
model ProductMapping {
  id          String   @id @default(cuid())
  keyword     String   @unique  // 検索キーワード（例: "pho", "tacos"）
  amazonUrl   String             // Amazon商品URL
  productName String             // 商品名
  category    String   @default("food")  // カテゴリ
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyword])
  @@index([isActive])
  @@map("product_mappings")
}

// セッション参加用ワンタイムトークン（LINE通知からの認証バイパス用）
model SessionToken {
  id            String   @id @default(cuid())
  token         String   @unique
  reservationId String
  userId        String
  expiresAt     DateTime
  usedAt        DateTime?  // 使用済みフラグ（nullなら未使用）
  createdAt     DateTime @default(now())

  @@index([token])
  @@index([reservationId])
  @@map("session_tokens")
}
