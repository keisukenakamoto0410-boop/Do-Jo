# ===========================================
# Do Jo - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
# For Vercel, use Vercel Postgres or external DB like Supabase, Railway, etc.
DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"

# NextAuth
# NEXTAUTH_URL should be your production domain on Vercel
NEXTAUTH_URL="https://your-domain.vercel.app"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here-generate-with-openssl"

# AWS S3 Configuration (for video/resume storage)
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="do-jo-uploads"

# Email Service (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@your-domain.com"

# Application URLs
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Optional: Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: LinkedIn OAuth
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# AI Services
# OpenAI - for Study Post image analysis
# Get your API key at https://platform.openai.com/
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic - for AI Meeting Advisor
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# Agora Video Call Integration
# Get your credentials at https://console.agora.io/
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# Google Sheets Integration (Optional - for data backup)
GOOGLE_SHEETS_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id-from-url"
